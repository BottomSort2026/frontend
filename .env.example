# Copy to .env.local. Nothing here is secret.

# Where the app sends API calls.
#   (empty)                 built-in sample data, no backend needed
#   /                       same origin: behind the gateway, or through the dev proxy below
#   http://localhost:3000   straight to a local gateway (needs CORS on the gateway)
VITE_API_URL=

# Dev server only: forward /chat, /lab and /datasets to the gateway. Use with VITE_API_URL=/
# Local gateway: http://localhost:3000. Under Compose: http://localhost:8080.
GATEWAY_URL=
